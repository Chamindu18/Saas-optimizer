# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (when ready to connect to PostgreSQL/Supabase)
# DATABASE_URL=your_database_url_here
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=saas_management
# DB_USER=postgres
# DB_PASSWORD=your_password

# CORS Configuration
FRONTEND_URL=http://localhost:3000

# Only if the API is behind a reverse proxy that overwrites X-Forwarded-For.
# List exact proxy IPs or narrow CIDR ranges; leave unset for direct access.
# TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128
