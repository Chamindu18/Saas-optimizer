# Server Configuration
PORT=5000
NODE_ENV=development

# Required PostgreSQL connection. Replace the placeholder privately.
DATABASE_URL=postgresql://seatwatch_user:REPLACE_WITH_URL_ENCODED_PASSWORD@127.0.0.1:5432/seatwatch_dev
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
# CORS Configuration
FRONTEND_URL=http://localhost:5173

# Only if the API is behind a reverse proxy that overwrites X-Forwarded-For.
# List exact proxy IPs or narrow CIDR ranges; leave unset for direct access.
# TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128
